---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SwitchArchiveView from '../../components/SwitchArchiveView.astro';
import collectionData from '../../data/collections.json';
import { navigationLabel } from '../../lib/collection-views';

export function getStaticPaths() {
  return [{
    params: { category: 'switches' },
  }];
}

const records = await getCollection('records');
const title = navigationLabel(collectionData, '/switches/');
---

<SiteLayout title={title} description={collectionData.copy['switch.description'] ?? undefined}>
  <SwitchArchiveView records={records} title={title} />
</SiteLayout>
