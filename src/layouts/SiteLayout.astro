---
import '../styles/global.css';
import TaxonomyNav from '../components/TaxonomyNav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'KEYLOG',
  description,
} = Astro.props;
const pageTitle = title === 'KEYLOG' ? title : `${title} — KEYLOG`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f4f2ed" />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href="/ui/gallery.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 이동</a>
    <slot name="header">
      <header class="site-header shell">
        <a class="wordmark" href="/" aria-label="KEYLOG 홈">KEYLOG</a>
        <TaxonomyNav />
      </header>
    </slot>
    <main id="main">
      <slot />
    </main>
    <script type="module" is:inline>
      import { bindGalleryInteractions } from '/ui/gallery.mjs';
      bindGalleryInteractions(document);
    </script>
  </body>
</html>
