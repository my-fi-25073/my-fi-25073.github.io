---
import type { CollectionEntry } from 'astro:content';
import { galleryImage, renderGalleryCard } from '../../public/ui/gallery.mjs';
import { domainSearchText } from '../lib/domain-display';
import { switchCoverImage } from '../lib/switch-tuning-display';
interface Props {
  record: CollectionEntry<'records'>['data'];
  headingLevel?: 2 | 3;
  groups?: string[];
  members?: CollectionEntry<'records'>['data'][];
}
const { record, headingLevel = 2, groups = [], members = [record] } = Astro.props;
const tuningCount = members.reduce((total, member) => total + member.tunings.length, 0);
const card = renderGalleryCard({
  title: record.modelFamily?.title ?? record.title,
  href: `/switches/${record.modelFamily?.slug ?? record.slug}/`, kind: 'switch', headingLevel,
  image: galleryImage(record.modelFamily && record.modelCover ? record.modelCover : switchCoverImage(record), 'switch'), metadata: [
    ...(tuningCount > 1 ? [{ value: `${tuningCount} tunings` }] : []),
  ],
  placeholderLogo: galleryImage(record.manufacturerLogo, 'vendor'),
  attributes: { 'data-archive-card': true, 'data-search': members.map(domainSearchText).join(' '), 'data-groups': JSON.stringify(groups), 'data-franken': record.isFranken },
});
---
<Fragment set:html={card} />
