---
import { getCollection, type CollectionEntry } from 'astro:content';
import DisplayFields from '../../components/DisplayFields.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import Lightbox from '../../components/Lightbox.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { buildDomainFields } from '../../lib/domain-display';
import { switchModelFamilies } from '../../lib/switch-models';
import { publicSwitchTunings, switchCoverImage } from '../../lib/switch-tuning-display';
import { galleryImage, renderGalleryCard } from '../../../public/ui/gallery.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('records');
  const families = switchModelFamilies(entries.map(({ data }) => data));
  for (const slug of families.keys()) {
    if (entries.some(({ data }) => data.slug === slug)) throw new Error(`Switch family route collision: ${slug}`);
  }
  return [
    ...entries.map(({ data: record }) => ({ params: { category: 'switches', slug: record.slug }, props: { records: [record], family: false } })),
    ...[...families].map(([slug, records]) => ({ params: { category: 'switches', slug }, props: { records, family: true } })),
  ];
}

interface Props { records: CollectionEntry<'records'>['data'][]; family: boolean; }
const { records, family } = Astro.props;
const record = records[0];
if (!family && record.modelFamily) return Astro.redirect(`/switches/${record.modelFamily.slug}/`);
const title = family ? record.modelFamily!.title : record.title;
const fields = family ? [] : buildDomainFields(record);
const sections = records.map((product) => ({
  placeholderLogo: product.manufacturerLogo,
  label: family ? product.modelFamily!.variantLabel : 'Tuning Specs',
  tunings: publicSwitchTunings(product).toSorted((a, b) => (
    Number(b.tuning.isStock === true || b.tuning.isFactoryConfiguration === true)
    - Number(a.tuning.isStock === true || a.tuning.isFactoryConfiguration === true)
  )),
}));
const partLabels = { stem: 'Stem', bottom_housing: 'Bottom housing', top_housing: 'Top housing' };
---
<SiteLayout title={title}>
  <article class="detail shell">
    <header class="detail-header"><h1>{title}</h1></header>
    {sections.map(({ label, tunings, placeholderLogo }) => tunings.length > 0 && (
      <section class="record-section switch-tunings" aria-label={label}>
        <div class="section-heading"><h2>{label}</h2></div>
        <ul class="kl-gallery">
          {tunings.map(({ label, href, tuning }) => <li set:html={renderGalleryCard({
            title: label, href, kind: 'switch', image: galleryImage(switchCoverImage(tuning), 'switch'),
            placeholderLogo: galleryImage(placeholderLogo, 'vendor'),
          })} />)}
        </ul>
      </section>
    ))}
    {!family && record.tunings.length === 0 && <ImageGallery images={record.images} label={title} />}
    {!family && record.parts.length > 0 && (
      <dl class="product-parts" aria-label="Franken components">
        {record.parts.map((part) => <div><dt>{partLabels[part.role]}</dt><dd>{part.donor}</dd></div>)}
      </dl>
    )}
    {fields.length > 0 && <section class="series-properties" aria-label="Switch information">
      <DisplayFields fields={fields} variant="detail" />
    </section>}
  </article>
  <Lightbox />
</SiteLayout>
