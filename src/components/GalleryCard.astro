---
import type { CollectionEntry } from 'astro:content';
import { galleryImage, renderGalleryCard } from '../../public/ui/gallery.mjs';
import { buildSeriesFields, galleryDisplay } from '../lib/gallery-display';
interface Props {
  gallery: CollectionEntry<'gallery'>['data'];
  groups?: string[];
  headingLevel?: 2 | 3;
  showProfile?: boolean;
}
const { gallery, groups = [], headingLevel = 2, showProfile = false } = Astro.props;
const cover = gallery.images[0];
const assetDigest = (path: string) => /-([a-f0-9]{12})-\d+\.(?:avif|webp)$/u.exec(path)?.[1];
const coverDigest = cover && assetDigest(cover.variants[0].src);
const kitPhoto = gallery.kits.map((kit) => {
  const photos = kit.images.filter(({ variants }) => variants.length
    && (!coverDigest || assetDigest(variants[0].src) !== coverDigest));
  return photos.find(({ variants }) => /-gallery-\d+-/u.test(variants[0].src)
    && !/-source-gallery-\d+-/u.test(variants[0].src)) ?? photos[0];
}).find(Boolean);
const cardKeys = galleryDisplay.homeCard;
const metadata = buildSeriesFields(gallery, showProfile && !cardKeys.includes('profile') ? [...cardKeys, 'profile'] : cardKeys);
const searchText = [gallery.title, gallery.manufacturer ?? '', gallery.profile ?? '', ...gallery.kits.map((kit) => kit.title)].join(' ').toLocaleLowerCase('ko');
const card = renderGalleryCard({
  title: gallery.title, href: `/gallery/${gallery.slug}/`, kind: 'keycap', headingLevel,
  image: galleryImage(cover, 'keycap'), previewImage: galleryImage(kitPhoto, 'keycap'), metadata,
  attributes: { 'data-archive-card': true, 'data-search': searchText, 'data-groups': JSON.stringify(groups) },
});
---
<Fragment set:html={card} />
