---
import type { CollectionEntry } from 'astro:content';
import { renderGalleryMedia } from '../../public/ui/gallery.mjs';
interface Props {
  images: CollectionEntry<'gallery'>['data']['images'];
  label: string;
  compact?: boolean;
  kind?: string;
}
const { images, label, compact = false, kind = 'switch' } = Astro.props;
---
{images.length > 0 && (
  <div class="kl-gallery-scope">
  <div class:list={['image-gallery', 'kl-gallery', { 'is-compact': compact }]} data-gallery-role="media" role="group" aria-label={label} data-image-gallery>
    {images.map((item, index) => {
      const full = item.variants.toSorted((a, b) => b.width - a.width)[0];
      return (
        <figure class:list={{ 'is-featured': index === 0 }}>
          <button class="image-gallery-button" data-ui="media" type="button" data-lightbox-open
            data-full={full.src} data-alt={item.alt} data-caption={item.caption ?? ''}
            aria-label={`${label} — image ${index + 1}`}
            set:html={renderGalleryMedia({ ...item, eager: !compact && index === 0 }, kind)} />
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      );
    })}
  </div>
  </div>
)}
