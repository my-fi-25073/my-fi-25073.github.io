{
  "name": "keylog-public",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ui:tokens": "node scripts/build-ui-tokens.mjs",
    "ui:footprints": "esbuild public/ui/footprint-viewer.mjs --bundle --format=esm --minify --outfile=public/ui/footprint-viewer.bundle.mjs",
    "ui:pcbs": "node scripts/build-pcb-viewer.mjs",
    "predev": "npm run ui:tokens",
    "prebuild": "npm run ui:tokens && npm run ui:footprints && npm run ui:pcbs",
    "precheck": "node scripts/build-ui-tokens.mjs --check",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "node --test",
    "check:size": "node scripts/check-size.mjs",
    "verify": "npm run test && npm run check && npm run build && npm run check:size"
  },
  "dependencies": {
    "astro": "7.0.7",
    "polygon-clipping": "0.15.7",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "esbuild": "0.28.1",
    "typescript": "6.0.3"
  }
}
