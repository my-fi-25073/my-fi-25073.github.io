---
import type { CollectionEntry } from 'astro:content';
import { galleryImage, renderGalleryCard } from '../../public/ui/gallery.mjs';
import { buildKeyboardCardFields } from '../lib/keyboard-display';
interface Props {
  keyboard: CollectionEntry<'keyboards'>['data'];
  eager?: boolean;
  groups?: string[];
  headingLevel?: 2 | 3;
}
const { keyboard, eager = false, groups = [], headingLevel = 2 } = Astro.props;
const searchText = [keyboard.title, ...keyboard.layouts, ...keyboard.build.keycaps.map((keycap) => keycap.title), ...keyboard.build.switches.map((item) => item.title)].join(' ').toLocaleLowerCase('ko');
const card = renderGalleryCard({
  title: keyboard.title, href: `/keyboards/${keyboard.slug}/`, kind: 'keyboard', headingLevel,
  image: { ...galleryImage(keyboard.images[0], 'keyboard'), eager }, metadata: buildKeyboardCardFields(keyboard),
  attributes: {
    'data-archive-card': true, 'data-keyboard-slug': keyboard.slug,
    'data-keyboard-title': keyboard.title, 'data-keyboard-date': keyboard.lastBuiltAt,
    'data-keyboard-layouts': JSON.stringify(keyboard.layouts), 'data-search': searchText,
    'data-groups': JSON.stringify(groups),
  },
});
---
<Fragment set:html={card} />
