---
import {getCollection} from 'astro:content';
import ArticlePage from '../../components/ArticlePage.astro';
export async function getStaticPaths(){return (await getCollection('posts')).filter(post=>post.data.section==='build-log'&&!post.data.draft).map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props;
---
<ArticlePage post={post}/>
