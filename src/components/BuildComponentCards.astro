---
import type { BuildComponentPresentation } from '../lib/build-component-covers';
import { galleryImage, renderGalleryCard } from '../../public/ui/gallery.mjs';
interface Props {
  items: Array<BuildComponentPresentation & { title: string; href: string; quantity?: number | null }>;
}
const { items } = Astro.props;
---
<ul class="kl-gallery">
  {items.map(({ title, href, quantity, cover, placeholderLogo, productTitle, tuningLabel, fields }) => (
    <li set:html={renderGalleryCard({
      title: productTitle ?? title, href, kind: href.startsWith('/switches/') ? 'switch' : 'keycap',
      image: galleryImage(cover, href.startsWith('/switches/') ? 'switch' : 'keycap'),
      placeholderLogo: galleryImage(placeholderLogo, 'vendor'),
      metadata: [...(tuningLabel ? [{ value: tuningLabel }] : []), ...(quantity != null ? [{ label: 'Quantity', value: String(quantity) }] : []), ...(fields ?? [])],
    })} />
  ))}
</ul>
