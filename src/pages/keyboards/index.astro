---
import { getCollection } from 'astro:content';
import CollectionFilter from '../../components/CollectionFilter.astro';
import KeyboardCard from '../../components/KeyboardCard.astro';
import collectionData from '../../data/collections.json';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  archiveDisplayGroups,
  groupIdsForRecord,
  groupsForCollectionView,
  groupsWithCounts,
  recordsForCollectionView,
  requiredCollectionView,
  type CollectionManifest,
} from '../../lib/collection-views';

const manifest = collectionData as CollectionManifest;
const pageCopy = manifest.copy;
const entries = await getCollection('keyboards');
const entryBySlug = new Map(entries.map((entry) => [entry.data.slug, entry]));
const records = recordsForCollectionView(
  entries.map((entry) => entry.data),
  manifest,
  'keyboard-all',
);
const filterViews = [
  { key: 'structure', label: '구조', viewId: 'keyboard-structures' },
  { key: 'arrangement', label: '배열', viewId: 'keyboard-arrangements' },
  { key: 'size', label: '크기', viewId: 'keyboard-sizes' },
];
const sizeUrlAliases = new Map(groupsForCollectionView(manifest, 'keyboard-sizes').map(({ id, match }) => {
  const values = match.operator === 'equals' ? [match.value] : (match.values ?? []);
  const aliases = values.flatMap((value) => (
    typeof value === 'string' && /^\d+%$/u.test(value) ? [value.slice(0, -1)] : []
  ));
  return [id, aliases] as const;
}));
const filterAxes = filterViews.map(({ key, label, viewId }) => ({
  key,
  label,
  groups: groupsWithCounts(records, manifest, [viewId]).map((group) => ({
    ...group,
    aliases: key === 'size' ? sizeUrlAliases.get(group.id) : undefined,
  })),
}));
const filterViewIds = filterViews.map(({ viewId }) => viewId);
const displayGroups = archiveDisplayGroups(records, manifest, 'keyboard-all');
const presets = requiredCollectionView(manifest, 'keyboard-all').view.projection.keyboardFilterPresets;
---

<SiteLayout title={pageCopy?.['keyboard.title'] ?? '키보드'} description={pageCopy?.['keyboard.description'] ?? undefined}>
  <div class="shell archive-catalog-shell">
    <section class="archive-catalog-heading" aria-labelledby="keyboard-title">
      <h1 id="keyboard-title" lang="en">Keyboard</h1>
      <div class="archive-search" role="search">
        <label class="visually-hidden" for="keyboard-search">키보드 검색</label>
        <input id="keyboard-search" type="search" placeholder="키보드 검색" autocomplete="off" />
      </div>
    </section>
    <div class="archive-catalog-layout">
      <aside class="archive-catalog-sidebar" aria-label="키보드 분류">
        <CollectionFilter axes={filterAxes} presets={presets} totalCount={records.length} />
      </aside>
      <div class="archive-catalog-main archive-catalog-gallery">
        <p class="archive-catalog-count" aria-live="polite"><span data-result-count>{records.length}</span>개 빌드</p>
        <div data-keyboard-gallery>
    {displayGroups.map(({ label, records }) => (
      <section class="archive-section kl-gallery-scope" aria-label={label ?? '키보드 목록'} data-archive-group>
        {label && <div class="section-heading"><h2>{label}</h2></div>}
        <div class="gallery-grid kl-gallery" data-gallery-role="archive">
          {records.map((keyboard) => {
            const entry = entryBySlug.get(keyboard.slug);
            if (!entry) throw new Error(`Keyboard entry is missing: ${keyboard.slug}`);
            const groups = groupIdsForRecord(keyboard, manifest, filterViewIds);
            return <KeyboardCard keyboard={entry.data} groups={groups} headingLevel={label ? 3 : 2} />;
          })}
        </div>
      </section>
    ))}
    <template data-keyboard-preset-section>
      <section class="archive-section kl-gallery-scope" aria-label="키보드 목록">
        <div class="section-heading" hidden><h2></h2></div>
        <div class="gallery-grid kl-gallery" data-gallery-role="archive"></div>
      </section>
    </template>
        </div>
        <p class="empty-keyboard-list" data-keyboard-empty hidden={records.length > 0}>조건에 맞는 키보드가 없습니다.</p>
      </div>
    </div>
  </div>
</SiteLayout>

<style>
  .empty-keyboard-list { margin-top: 24px; color: var(--k-muted); }
</style>
