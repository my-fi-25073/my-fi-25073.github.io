---
import collectionData from '../data/collections.json';
import SiteLayout from '../layouts/SiteLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import smallHero from '../assets/keylog-hero-800.avif';
import mediumHero from '../assets/keylog-hero-1600.avif';
import largeHero from '../assets/keylog-hero-2400.avif';
import { projectSections } from '../lib/site-sections.mjs';

const archiveIds = ['keyboards', 'keycaps', 'switches', 'recap'];
const archives = archiveIds.map((id) => {
  const item = collectionData.navigation.find((entry) => entry.id === id);
  if (!item) throw new Error(`Missing Home navigation for ${id}`);
  return item;
});
const sources = [smallHero, mediumHero, largeHero]
  .map(({ src, width }) => `${src} ${width}w`).join(', ');
---

<SiteLayout description={collectionData.copy['home.description'] ?? undefined}>
  <header slot="header" class="home-shell home-header">
    <div class="k-theme-control"><a class="home-wordmark" href="/" aria-current="page">KEYLOG</a><ThemeToggle /></div>
    <a class="home-live-link" href="https://my-fi-25073.github.io/" target="_blank" rel="noopener noreferrer">현재 배포판 <span aria-hidden="true">↗</span></a>
  </header>
  <div class="home-shell">
    <section class="home-cover" aria-labelledby="home-title">
      <img src={mediumHero.src} srcset={sources}
        sizes="(max-width: 680px) calc(100vw - 32px), (max-width: 1480px) calc(100vw - 40px), 1440px"
        width={mediumHero.width} height={mediumHero.height}
        alt="베이지색 키캡을 장착한 키보드들" fetchpriority="high" />
      <h1 id="home-title" class="display-heading">Keylog</h1>
    </section>
    <nav class="home-directory" aria-label="아카이브">
      {archives.map(({ href, label }) => (
        <a href={href}>
          <strong>{label}</strong><span aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
    <nav class="home-directory home-projects" aria-label="프로젝트와 기록">
      {projectSections.map(({href,label})=>(<a href={href}><strong>{label}</strong><span aria-hidden="true">↗</span></a>))}
    </nav>
  </div>
</SiteLayout>

<style>
  .home-shell { width: min(calc(100% - 40px), 1440px); margin-inline: auto; }
  .home-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 50px;
    margin-bottom: 8px;
  }
  .home-wordmark { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 750; letter-spacing: .11em; }
  .home-live-link { font-size: 13px; color: var(--k-muted); padding: 10px 0; }
  :global(body:not([data-studio-preview])) .home-live-link { display: none; }
  .home-live-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .home-cover {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: clamp(380px, 72.3svh, 690px);
    overflow: hidden;
    background: #34241b;
  }
  .home-cover img, .home-cover::after { position: absolute; inset: 0; width: 100%; height: 100%; }
  .home-cover img { z-index: -2; object-fit: cover; object-position: center 55%; }
  .home-cover::after {
    content: "";
    z-index: -1;
    background: linear-gradient(23deg, #24190edb, transparent 59%);
  }
  .home-cover h1 {
    margin: 0;
    padding: clamp(22px, 5vw, 76px);
    color: #fff6ea;
    font-size: clamp(4.9rem, 13vw, 11.25rem);
  }
  .home-directory {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 24px;
    margin-top: 18px;
    border-bottom: 1px solid var(--k-rule);
  }
  .home-directory a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 82px;
    padding-inline: 3px;
  }
  .home-projects { margin-top:0; }
  .home-directory a:hover strong, .home-directory a:focus-visible strong { text-decoration: underline; text-underline-offset: 5px; }
  .home-directory a > span:last-child { color: var(--k-muted); }
  .home-directory strong { font-size: clamp(1.05rem, 1.8vw, 1.45rem); font-weight: 660; letter-spacing: -.035em; }
  @media (max-width: 680px) {
    .home-shell { width: calc(100% - 32px); }
    .home-cover { min-height: clamp(390px, 66svh, 570px); }
    .home-cover img { object-position: 48% center; }
    .home-cover h1 { font-size: clamp(4.25rem, 13vw, 7rem); }
    .home-directory { grid-template-columns: 1fr 1fr; gap: 0 12px; margin-top: 8px; }
    .home-directory a { min-height: 62px; gap: 8px; }
    .home-directory a:nth-child(-n+2) { border-bottom: 1px solid var(--k-rule); }
  }
</style>
