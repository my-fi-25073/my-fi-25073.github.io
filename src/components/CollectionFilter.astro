---
import type { KeyboardFilterPreset } from '../lib/collection-views';

interface FilterGroup {
  id: string;
  label: string;
  count: number;
  aliases?: string[];
}

interface FilterAxis {
  key: string;
  label: string;
  groups: FilterGroup[];
}

interface Props {
  axes: FilterAxis[];
  presets?: Record<string, KeyboardFilterPreset>;
  totalCount: number;
}

const { axes, presets = {}, totalCount } = Astro.props;
---

<details class="keyboard-filters" data-keyboard-filters data-presets={JSON.stringify(presets)} open>
  <summary>분류</summary>
  <div class="filter-axes">
  {axes.map((axis) => (
    <fieldset class="k-filter-axis">
      <legend>{axis.label}</legend>
      <div class="k-filter-options">
        <label class="k-filter-option">
          <input type="radio" name={axis.key} value="" checked />
          <span>All<small aria-hidden="true">{totalCount}</small></span>
        </label>
        {axis.groups.map((group) => (
          <label class="k-filter-option">
            <input type="radio" name={axis.key} value={group.id} data-aliases={group.aliases?.join(' ')} />
            <span>{group.label}<small aria-hidden="true">{group.count}</small></span>
          </label>
        ))}
      </div>
    </fieldset>
  ))}
  </div>
</details>

<script>
  import type { KeyboardFilterPreset } from '../lib/collection-views';

  const root = document.querySelector<HTMLElement>('[data-keyboard-filters]');
  const search = document.querySelector<HTMLInputElement>('#keyboard-search');
  const total = document.querySelector<HTMLElement>('[data-result-count]');
  const empty = document.querySelector<HTMLElement>('[data-keyboard-empty]');
  const gallery = document.querySelector<HTMLElement>('[data-keyboard-gallery]');
  const sectionTemplate = gallery?.querySelector<HTMLTemplateElement>('[data-keyboard-preset-section]');

  if (root && search && total && empty && gallery && sectionTemplate) {
    const smallScreen = matchMedia('(max-width: 660px)');
    const setFilterDisclosure = () => root.toggleAttribute('open', !smallScreen.matches);
    setFilterDisclosure();
    smallScreen.addEventListener('change', setFilterDisclosure);
    const presets: Record<string, KeyboardFilterPreset> = JSON.parse(root.dataset.presets ?? '{}');
    const axes = [...root.querySelectorAll('fieldset')].map((field) => (
      [...field.querySelectorAll<HTMLInputElement>('input[type="radio"]')]
    ));
    const groups = [...gallery.querySelectorAll<HTMLElement>('[data-archive-group]')].map((section) => ({
      section,
      cards: [...section.querySelectorAll<HTMLElement>('[data-archive-card]')].map((card) => ({
        card,
        slug: card.dataset.keyboardSlug!,
        title: card.dataset.keyboardTitle!,
        lastBuiltAt: card.dataset.keyboardDate,
        layouts: JSON.parse(card.dataset.keyboardLayouts ?? '[]') as string[],
        searchText: card.dataset.search ?? '',
        tags: new Set<string>(JSON.parse(card.dataset.groups ?? '[]')),
      })),
    }));
    const entries = [...new Map(groups.flatMap(({ cards }) => cards.map((entry) => [entry.slug, entry]))).values()];
    type Entry = (typeof entries)[number];
    let currentPreset: KeyboardFilterPreset | null = null;
    let presetGroups: Array<{ section: HTMLElement; cards: Entry[] }> = [];

    function compareEntries(left: Entry, right: Entry, preset: KeyboardFilterPreset) {
      // SQLite's NOCASE folds ASCII only. Use the public slug for otherwise identical records.
      const fold = (value: string) => value.replace(/[A-Z]/g, (letter) => letter.toLowerCase());
      for (const { field, direction } of preset.sort) {
        const a = field === 'firstLayout' ? left.layouts[0] : left[field];
        const b = field === 'firstLayout' ? right.layouts[0] : right[field];
        if (a == null || b == null) {
          if (a !== b) return a == null ? 1 : -1;
          continue;
        }
        const aa = fold(a);
        const bb = fold(b);
        if (aa !== bb) return (aa < bb ? -1 : 1) * (direction === 'desc' ? -1 : 1);
      }
      return left.slug < right.slug ? -1 : left.slug > right.slug ? 1 : 0;
    }

    function buildPresetGroups(preset: KeyboardFilterPreset, filter: string, template: HTMLTemplateElement) {
      const sorted = entries.filter(({ tags }) => tags.has(filter))
        .toSorted((left, right) => compareEntries(left, right, preset));
      const members = preset.groups.length ? [
        ...preset.groups.map((label) => ({ label, entries: sorted.filter(({ layouts }) => layouts.includes(label)) })),
        { label: '값 없음', entries: sorted.filter(({ layouts }) => !layouts.some((label) => preset.groups.includes(label))) },
      ] : [{ label: null, entries: sorted }];
      return members.filter((group) => group.entries.length).map(({ label, entries: groupEntries }) => {
        const section = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const heading = section.querySelector<HTMLElement>('.section-heading')!;
        const grid = section.querySelector<HTMLElement>('.gallery-grid')!;
        if (label) {
          section.setAttribute('aria-label', label);
          heading.querySelector('h2')!.textContent = label;
          heading.hidden = false;
        }
        const cards = groupEntries.map((entry) => {
          const card = entry.card.cloneNode(true) as HTMLElement;
          const oldTitle = card.querySelector('h2, h3')!;
          const title = document.createElement(label ? 'h3' : 'h2');
          title.textContent = oldTitle.textContent;
          oldTitle.replaceWith(title);
          grid.append(card);
          return { ...entry, card };
        });
        return { section, cards };
      });
    }

    function readLocation() {
      const params = new URLSearchParams(window.location.search);
      for (const options of axes) {
        const requested = params.get(options[0].name) ?? params.get('collection');
        const selected = options.find((option) => (
          option.value === requested || (requested && option.dataset.aliases?.split(' ').includes(requested))
        ));
        (selected ?? options[0]).checked = true;
      }
    }

    const apply = (updateUrl = false) => {
      const selected = axes.map((options) => options.find((option) => option.checked) ?? options[0]);
      const active = selected.map((option) => option.value).filter(Boolean);
      const preset = active.length === 1 ? presets[active[0]] ?? null : null;
      if (preset !== currentPreset) {
        currentPreset = preset;
        presetGroups = preset ? buildPresetGroups(preset, active[0], sectionTemplate) : [];
        gallery.replaceChildren(...(preset ? presetGroups : groups).map(({ section }) => section), sectionTemplate);
      }
      const query = search.value.trim().toLocaleLowerCase('ko');
      const visible = new Set<string>();
      for (const { section, cards } of preset ? presetGroups : groups) {
        let sectionHasMatch = false;
        for (const { card, slug, searchText, tags } of cards) {
          const matches = (!query || searchText.includes(query)) && active.every((value) => tags.has(value));
          card.hidden = !matches;
          if (matches) {
            visible.add(slug);
            sectionHasMatch = true;
          }
        }
        section.hidden = !sectionHasMatch;
      }
      total.textContent = String(visible.size);
      empty.hidden = visible.size !== 0;
      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.delete('collection');
        for (const option of selected) {
          if (option.value) url.searchParams.set(option.name, option.value);
          else url.searchParams.delete(option.name);
        }
        window.history.replaceState(null, '', url);
      }
    };

    root.addEventListener('change', (event) => {
      if (event.target instanceof HTMLInputElement && event.target.type === 'radio') apply(true);
    });
    search.addEventListener('input', () => apply());
    window.addEventListener('popstate', () => {
      readLocation();
      apply();
    });
    readLocation();
    apply();
  }
</script>

<style>
  summary { display: none; }

  @media (max-width: 660px) {
    summary { display: flex; }
    .filter-axes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; padding-top: 15px; }
  }
</style>
