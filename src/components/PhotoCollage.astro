---
import type { CollectionEntry } from 'astro:content';
import Lightbox from './Lightbox.astro';

interface Props { images: CollectionEntry<'photoPosts'>['data']['images']; portraitColumn?: boolean; fillLast?: boolean }
const { images, portraitColumn, fillLast } = Astro.props;
const photos = images.map(image => {
  const full = image.variants.reduce((a, b) => a.width >= b.width ? a : b);
  return { ...full, alt: image.alt, ratio: full.width / full.height };
});
const clamp = (value: number, low: number, high: number) => Math.max(low, Math.min(high, value));
const tiles: { x: number; y: number; w: number; h: number }[] = [];
let aspect: number;
if (portraitColumn && photos.length === 3) {
  const [first, second, portrait] = photos.map(photo => photo.ratio);
  const left = 1 / (1 / first + 1 / second);
  aspect = left + portrait;
  const width = left / aspect;
  const height = left / first;
  tiles.push({ x: 0, y: 0, w: width, h: height },
    { x: 0, y: height, w: width, h: 1 - height },
    { x: width, y: 0, w: 1 - width, h: 1 });
} else if (photos.length >= 3) {
  // Begin with a single lead image beside two stacked photos.
  const [lead, top, bottom] = photos.map(photo => photo.ratio);
  const right = 1 / (1 / top + 1 / bottom);
  const leadHeight = 1 / clamp(lead + right, 1, 2);
  const split = clamp(lead / (lead + right), 0.52, 0.70);
  const topHeight = leadHeight * clamp(right / top, 0.36, 0.64);
  tiles.push({ x: 0, y: 0, w: split, h: leadHeight },
    { x: split, y: 0, w: 1 - split, h: topHeight },
    { x: split, y: topHeight, w: 1 - split, h: leadHeight - topHeight });
  let height = leadHeight;
  for (let i = 3; i < photos.length;) {
    const count = photos.length - i === 3 ? 3 : 2;
    const row = photos.slice(i, i + count);
    const h = 1 / row.reduce((sum, photo) => sum + photo.ratio, 0);
    let x = 0;
    for (const photo of row) {
      const w = photo.ratio * h;
      tiles.push({ x, y: height, w, h });
      x += w;
    }
    height += h;
    i += row.length;
  }
  aspect = 1 / height;
  for (const tile of tiles) {
    tile.y /= height;
    tile.h /= height;
  }
} else {
  aspect = photos.reduce((sum, photo) => sum + photo.ratio, 0);
  let x = 0;
  for (const photo of photos) {
    const w = photo.ratio / aspect;
    tiles.push({ x, y: 0, w, h: 1 });
    x += w;
  }
}
---
<section class="collage" aria-label="Photos" data-image-gallery style={`aspect-ratio:${aspect}`}>
  {photos.map((photo, index) => {
    const { x, y, w, h } = tiles[index];
    const scale = (w / h * aspect) / photo.ratio;
    const allowMargin = !(fillLast && index === photos.length - 1);
    const fit = allowMargin && Math.min(scale, 1 / scale) < 0.80 ? 'contain' : 'cover';
    return <button type="button" data-ui="media" data-lightbox-open
      data-full={photo.src} data-alt={photo.alt} aria-label={`Open photo ${index + 1} of ${photos.length}`}
      style={`left:${x * 100}%;top:${y * 100}%;width:${w * 100}%;height:${h * 100}%`}>
      <img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt}
        style={`object-fit:${fit}`} loading={index === 0 ? 'eager' : 'lazy'} />
    </button>;
  })}
</section>
<Lightbox />
<style>
  .collage { position: relative; margin-block: var(--k-space-6); }
  .collage button { position: absolute; padding: clamp(1px, .18vw, 3px); box-sizing: border-box; }
  .collage button:focus-visible { z-index: 1; }
  .collage img { display: block; width: 100%; height: 100%; }
</style>
