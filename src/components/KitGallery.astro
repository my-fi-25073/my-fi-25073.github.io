---
import ImageGallery from './ImageGallery.astro';

interface ImageVariant {
  src: string;
  width: number;
  height: number;
}

interface GalleryImage {
  alt: string;
  caption?: string;
  variants: ImageVariant[];
}

interface Kit {
  slug: string;
  title: string;
  kittingTypes: string[];
  images: GalleryImage[];
}

interface Props {
  seriesTitle: string;
  kits: Kit[];
}

const { seriesTitle, kits } = Astro.props;
---

{kits.length > 0 && (
  <section class="kit-gallery-section record-section" aria-label="키캡 킷">
    <div class="kit-gallery">
      {kits.map((kit) => (
        <article id={kit.slug} class="kit-card">
          {kit.images.length > 0 ? (
            <ImageGallery
              images={kit.images}
              label={`${seriesTitle} ${kit.title}`}
              compact
            />
          ) : (
            <div class="kit-card-media empty-media" aria-hidden="true"></div>
          )}
          <div class="kit-card-copy">
            <h3>{kit.title}</h3>
          </div>
        </article>
      ))}
    </div>
  </section>
)}
