---
import type { CollectionEntry } from 'astro:content';
import collectionData from '../data/collections.json';
import {
  archiveDisplayGroups,
  groupIdsForRecord,
  groupsWithCounts,
  recordsForCollectionView,
  recordsGroupedByField,
  type CollectionManifest,
} from '../lib/collection-views';
import DomainRecordCard from './DomainRecordCard.astro';
import { switchArchiveRecords, switchModelFamilies } from '../lib/switch-models';
import { renderBrandMark } from '../../public/ui/gallery.mjs';

interface Props {
  records: CollectionEntry<'records'>[];
}

const { records } = Astro.props;
const manifest = collectionData as CollectionManifest;
const sourceRecords = records.map((entry) => entry.data);
const families = switchModelFamilies(sourceRecords);
const products = switchArchiveRecords(sourceRecords);
const switches = recordsForCollectionView(products, manifest, 'switch-manufacturers');
const franken = recordsForCollectionView(products, manifest, 'switch-franken');
const switchGroups = archiveDisplayGroups(switches, manifest, 'switch-manufacturers');
const frankenGroups = archiveDisplayGroups(franken, manifest, 'switch-franken');
const makerGroups = groupsWithCounts(switches, manifest, ['switch-manufacturers']);
const footprintGroups = recordsGroupedByField(switches, 'footprintType', [], 'asc');
const browsingViews = [
  {
    id: 'switches',
    label: '제조사별',
    facetLabel: '제조사',
    parameter: 'maker',
    options: makerGroups,
    groups: switchGroups,
    membership: (record: typeof switches[number]) => groupIdsForRecord(record, manifest, ['switch-manufacturers']),
  },
  {
    id: 'footprints',
    label: '규격별',
    facetLabel: '규격',
    parameter: 'footprint',
    options: footprintGroups.flatMap(({ label, records }) => label ? [{ id: label, label, count: records.length }] : []),
    groups: footprintGroups,
    membership: (record: typeof switches[number]) => record.footprintType ? [record.footprintType] : [],
  },
];
const viewTabs = [...browsingViews, { id: 'franken', label: '프랑켄' }];
---

<div class="shell archive-catalog-shell">
  <header class="archive-catalog-heading">
    <h1 lang="en">Switch</h1>
    <div class="filter-search" role="search">
      <label class="visually-hidden" for="switch-search">스위치 검색</label>
      <input id="switch-search" type="search" placeholder="스위치 검색" autocomplete="off" />
    </div>
  </header>

  <div class="archive-catalog-layout">
    <details class="archive-catalog-sidebar switch-sidebar" open>
      <summary>분류</summary>
      <fieldset class="k-filter-axis">
        <legend>보기</legend>
        {viewTabs.map(({ id, label }, index) => (
          <label class="k-filter-option">
            <input type="radio" name="switch-view" value={id} checked={index === 0} />
            <span>{label}</span>
          </label>
        ))}
      </fieldset>
      {browsingViews.map(({ id, facetLabel, parameter, options }, index) => (
        <fieldset class="k-filter-axis" data-switch-facet={id} hidden={index > 0}>
          <legend>{facetLabel}</legend>
          {[{ id: '', label: 'All', count: switches.length }, ...options].map((group) => (
            <label class="k-filter-option">
              <input type="radio" name={parameter} value={group.id} checked={group.id === ''} />
              <span>{group.label}</span>
              <small aria-hidden="true">{group.count}</small>
            </label>
          ))}
        </fieldset>
      ))}
    </details>
    <section class="archive-catalog-main archive-catalog-gallery" aria-label="스위치 목록">
      <p class="result-count" aria-live="polite" aria-atomic="true"><span data-switch-result-count>{switches.length}</span>개 스위치</p>
      {[...browsingViews, {
        id: 'franken',
        parameter: undefined,
        groups: frankenGroups,
        membership: () => [],
      }].map(({ id, parameter, groups, membership }, index) => (
        <div data-switch-panel={id} data-switch-parameter={parameter} hidden={index > 0}>
          <p data-switch-empty hidden={(id === 'franken' ? franken : switches).length > 0}>
            {id === 'franken' ? '조건에 맞는 프랑켄 스위치가 없습니다.' : '조건에 맞는 스위치가 없습니다.'}
          </p>
          {groups.map(({ label, records }) => {
            const mark = id === 'switches' ? renderBrandMark(records.find(record => record.manufacturer === label)?.manufacturerLogo) : '';
            return (
            <details class="archive-section kl-gallery-scope" aria-label={label ?? '스위치 목록'} data-archive-group open>
              <summary><h2 class="k-brand-heading" aria-label={label ?? '스위치 목록'}>
                {mark ? <Fragment set:html={mark} /> : <span>{label}</span>}
              </h2><small>{records.length}</small></summary>
              {id === 'switches' && new Set(records.map(record=>record.footprintType)).size > 1 ? recordsGroupedByField(records,'footprintType',[],'asc').map(subgroup=>(
                <details class="record-section" open><summary><strong>{subgroup.label ?? '미지정'}</strong><small>{subgroup.records.length}</small></summary>
                  <div class="gallery-grid kl-gallery" data-gallery-role="archive">{subgroup.records.map(record=><DomainRecordCard record={record} members={record.modelFamily ? families.get(record.modelFamily.slug) : undefined} headingLevel={3} groups={membership(record)} />)}</div>
                </details>
              )) :
              <div class="gallery-grid kl-gallery" data-gallery-role="archive">
                {records.map((record) => (
                  <DomainRecordCard record={record} members={record.modelFamily ? families.get(record.modelFamily.slug) : undefined}
                    headingLevel={label ? 3 : 2} groups={membership(record)} />
                ))}
              </div>}
            </details>
          );})}
        </div>
      ))}
    </section>
  </div>
</div>

<script>
  const search = document.querySelector<HTMLInputElement>('#switch-search');
  const count = document.querySelector<HTMLElement>('[data-switch-result-count]');
  const sidebar = document.querySelector<HTMLDetailsElement>('.switch-sidebar');
  const mode = [...(sidebar?.querySelectorAll<HTMLInputElement>('input[name="switch-view"]') ?? [])];
  const views = [...document.querySelectorAll<HTMLElement>('[data-switch-panel]')].map((panel) => {
    const id = panel.dataset.switchPanel!;
    const facet = sidebar?.querySelector<HTMLElement>(`[data-switch-facet="${id}"]`);
    return {
      id,
      panel,
      facet,
      parameter: panel.dataset.switchParameter,
      options: [...(facet?.querySelectorAll<HTMLInputElement>('input[type="radio"]') ?? [])],
      empty: panel.querySelector<HTMLElement>('[data-switch-empty]')!,
      groups: [...panel.querySelectorAll<HTMLElement>('[data-archive-group]')].map((section) => ({
        section,
        cards: [...section.querySelectorAll<HTMLElement>('[data-archive-card]')].map((card) => ({
          card,
          href: card.querySelector('a')!.href,
          searchText: card.dataset.search ?? '',
          membership: new Set<string>(JSON.parse(card.dataset.groups ?? '[]')),
        })),
      })),
    };
  });

  function apply() {
    const active = mode.find((input) => input.checked)?.value;
    const view = views.find(({ id }) => id === active);
    if (!view || !search || !count) return;
    for (const entry of views) {
      entry.panel.hidden = entry !== view;
      if (entry.facet) entry.facet.hidden = entry !== view;
    }
    const query = search.value.trim().toLocaleLowerCase('ko');
    const selected = view.options.find((input) => input.checked)?.value ?? '';
    const visible = new Set<string>();
    for (const { section, cards } of view.groups) {
      let hasMatch = false;
      for (const { card, href, searchText, membership } of cards) {
        const matches = (!query || searchText.includes(query)) && (!selected || membership.has(selected));
        card.hidden = !matches;
        if (!matches) continue;
        hasMatch = true;
        visible.add(href);
      }
      section.hidden = !hasMatch;
    }
    count.textContent = String(visible.size);
    view.empty.hidden = visible.size !== 0;
  }

  function fromLocation() {
    const params = new URLSearchParams(window.location.search);
    const selectedMode = mode.find((input) => input.value === params.get('view')) ?? mode[0];
    if (selectedMode) selectedMode.checked = true;
    for (const { parameter, options } of views) {
      if (!parameter) continue;
      const requested = params.get(parameter) ?? (parameter === 'maker' ? params.get('collection') : null);
      const input = options.find((candidate) => candidate.value === requested) ?? options[0];
      if (input) input.checked = true;
    }
    apply();
  }

  sidebar?.addEventListener('change', (event) => {
    if (!(event.target instanceof HTMLInputElement) || event.target.type !== 'radio') return;
    const { name, value } = event.target;
    const url = new URL(window.location.href);
    url.searchParams.delete('rating');
    if (name === 'switch-view') {
      if (value === 'switches') url.searchParams.delete('view');
      else url.searchParams.set('view', value);
      if (url.href !== window.location.href) window.history.pushState(null, '', url);
    } else {
      if (name === 'maker') url.searchParams.delete('collection');
      if (value) url.searchParams.set(name, value);
      else url.searchParams.delete(name);
      window.history.replaceState(null, '', url);
    }
    apply();
  });
  search?.addEventListener('input', apply);
  window.addEventListener('popstate', fromLocation);
  fromLocation();
</script>

<style>
  .result-count { margin: 0; min-height: 38px; padding-top: 5px; color: var(--k-muted); font-size: 13px; font-variant-numeric: tabular-nums; text-align: right; }
  .filter-search { position: relative; flex: 0 1 232px; width: min(100%, 232px); }
  .switch-sidebar summary { display: none; }
  [data-switch-empty] { margin-top: 24px; color: var(--k-muted); }

  @media (max-width: 660px) {
    .switch-sidebar summary { display: flex; }
  }

  @media (max-width: 440px) {
    .filter-search { flex-basis: auto; width: 100%; }
  }
</style>
