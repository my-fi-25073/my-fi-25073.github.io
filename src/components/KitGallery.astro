---
import type { CollectionEntry } from 'astro:content';
import { galleryImage, renderGalleryCard } from '../../public/ui/gallery.mjs';
interface Props {
  seriesTitle: string;
  kits: CollectionEntry<'gallery'>['data']['kits'];
}
const { seriesTitle, kits } = Astro.props;
---
{kits.length > 0 && (
  <section class="kit-gallery-section record-section kl-gallery-scope" aria-label="Kits">
    <div class="kl-gallery" data-gallery-role="archive">
      {kits.map((kit) => {
        const full = kit.images[0]?.variants.toSorted((a, b) => b.width - a.width)[0];
        return <div data-image-gallery aria-label={`${seriesTitle} ${kit.title}`}>
          <Fragment set:html={renderGalleryCard({
            title: kit.title, kind: 'kit', image: galleryImage(kit.images[0], 'kit'),
            href: full?.src ?? '', attributes: { id: kit.slug },
            linkAttributes: full ? {
              'data-lightbox-open': true, 'data-full': full.src,
              'data-alt': kit.images[0].alt, 'data-caption': kit.images[0].caption ?? '',
              'aria-label': `${kit.title} — view images`,
            } : {},
          })} />
          {kit.images.slice(1).map((image) => <button hidden type="button" data-lightbox-open
            data-full={image.variants.toSorted((a, b) => b.width - a.width)[0].src}
            data-alt={image.alt} data-caption={image.caption ?? ''} aria-label={image.alt} />)}
        </div>;
      })}
    </div>
  </section>
)}
