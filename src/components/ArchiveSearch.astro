---
interface Props {
  label: string;
  disabled?: boolean;
}

const { label, disabled = false } = Astro.props;
---
<div class="archive-search" role="search">
  <label class="visually-hidden" for="archive-search-input">{label}</label>
  <input
    id="archive-search-input"
    class="k-input"
    type="search"
    placeholder="Search"
    autocomplete="off"
    disabled={disabled}
    data-archive-search
  />
</div>

<script>
  const disclosures = document.querySelectorAll<HTMLDetailsElement>('[data-archive-disclosure]');
  if (disclosures.length) {
    const mobile = matchMedia('(max-width: 660px)');
    const sync = () => disclosures.forEach(disclosure => { disclosure.open = !mobile.matches; });
    sync();
    mobile.addEventListener('change', sync);
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-archive-filter]')) {
    const input = root.querySelector<HTMLInputElement>('[data-archive-search]');
    if (!input) continue;
    const update = () => {
      const panel = root.querySelector<HTMLElement>('[data-archive-search-panel]:not([hidden])') ?? root;
      const query = input.value.trim().toLocaleLowerCase('ko');
      const selection = root.querySelector<HTMLInputElement>('[data-archive-search-facet]:checked')?.value;
      const visible = new Set<string | HTMLElement>();
      for (const card of panel.querySelectorAll<HTMLElement>('[data-archive-card]')) {
        const matchesSearch = !query || (card.dataset.search ?? '').includes(query);
        const matchesFacet = !selection || card.dataset.archiveFacet === selection;
        card.hidden = !matchesSearch || !matchesFacet;
        if (!card.hidden) visible.add(card.querySelector('a')?.href ?? card);
      }
      for (const group of panel.querySelectorAll<HTMLElement>('[data-archive-group]')) {
        group.hidden = !group.querySelector('[data-archive-card]:not([hidden])');
      }
      const count = panel.querySelector('[data-archive-search-count]');
      if (count) count.textContent = String(visible.size);
      const empty = panel.querySelector<HTMLElement>('[data-archive-search-empty]');
      if (empty) empty.hidden = visible.size > 0;
    };
    input.addEventListener('input', update);
    root.addEventListener('change', (event) => {
      if (event.target instanceof HTMLInputElement && event.target.hasAttribute('data-archive-search-facet')) update();
    });
    root.addEventListener('keylog:archive-view-change', update);
    update();
  }
</script>

<style>
  .archive-search { border-bottom: var(--k-border-width) solid var(--k-rule); }
  .archive-search:not(:last-child) { margin-bottom: var(--k-space-4); }

  .archive-search:focus-within {
    border-bottom-color: var(--k-focus);
    box-shadow: inset 0 -1px var(--k-focus);
  }

  .archive-search :global(.k-field-group) { background: transparent; }
  .archive-search :global(.k-field-group)::after { border: 0; }

  .archive-search input {
    border: 0;
    background: transparent;
    padding-inline: var(--k-space-2);
    font-size: var(--k-type-control);
  }

  .archive-search input:focus-visible { outline: none; }
</style>
