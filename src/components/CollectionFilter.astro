---
interface FilterGroup {
  id: string;
  label: string;
  aliases?: string[];
}

interface FilterAxis {
  key: string;
  label: string;
  groups: FilterGroup[];
}

interface Props {
  axes: FilterAxis[];
  scopeId?: string;
}

const { axes, scopeId } = Astro.props;
---

<div class="collection-filter" data-collection-filter data-filter-scope={scopeId}>
  {axes.map((axis) => (
    <select name={axis.key} aria-label={axis.label}>
      <option value="">{axis.label} 전체</option>
      {axis.groups.map((group) => (
        <option value={group.id} data-aliases={group.aliases?.join(' ')}>{group.label}</option>
      ))}
    </select>
  ))}
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-collection-filter]')) {
    const selects = [...root.querySelectorAll<HTMLSelectElement>('select')];
    const scope = (root.dataset.filterScope
      ? document.getElementById(root.dataset.filterScope)
      : document) ?? document;
    const cards = [...scope.querySelectorAll<HTMLElement>('[data-archive-card]')].map((card) => ({
      card,
      groups: new Set<string>(JSON.parse(card.dataset.groups ?? '[]')),
    }));
    const params = new URL(window.location.href).searchParams;
    for (const select of selects) {
      const requested = params.get(select.name) ?? params.get('collection');
      if (!requested) continue;
      const selected = [...select.options].find((option) => (
        option.value === requested || option.dataset.aliases?.split(' ').includes(requested)
      ));
      if (selected) select.value = selected.value;
    }
    const apply = (updateUrl = false) => {
      const activeGroups = selects.map((select) => select.value).filter(Boolean);
      for (const { card, groups } of cards) {
        card.dataset.groupMatch = String(activeGroups.every((group) => groups.has(group)));
      }
      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.delete('collection');
        for (const select of selects) {
          if (select.value) url.searchParams.set(select.name, select.value);
          else url.searchParams.delete(select.name);
        }
        window.history.replaceState(null, '', url);
      }
      window.dispatchEvent(new CustomEvent('keylog:group-filter'));
    };
    root.addEventListener('change', () => apply(true));
    apply();
  }
</script>
