---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Lightbox from '../../components/Lightbox.astro';
import DisplayFields from '../../components/DisplayFields.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import KitGallery from '../../components/KitGallery.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { buildSeriesFields, galleryDisplay } from '../../lib/gallery-display';

export async function getStaticPaths() {
  const galleries = await getCollection('gallery');
  return galleries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'gallery'>;
}

const { entry } = Astro.props;
const gallery = entry.data;
const detailFields = buildSeriesFields(gallery, galleryDisplay.seriesDetail);
---

<SiteLayout title={gallery.title}>
  <article class="detail shell">
    <header class="detail-header">
      <h1>{gallery.title}</h1>
    </header>

    <ImageGallery images={gallery.images} label={gallery.title} />

    <KitGallery seriesTitle={gallery.title} kits={gallery.kits} />

    <section class="series-properties" aria-label="키캡 정보">
      <DisplayFields fields={detailFields} variant="detail" />
    </section>
  </article>
  <Lightbox />
</SiteLayout>
