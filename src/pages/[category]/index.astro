---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SwitchArchiveView from '../../components/SwitchArchiveView.astro';
import collectionData from '../../data/collections.json';

export function getStaticPaths() {
  return [{
    params: { category: 'switches' },
  }];
}

const records = await getCollection('records');
---

<SiteLayout title={collectionData.copy['switch.title'] ?? '스위치'} description={collectionData.copy['switch.description'] ?? undefined}>
  <SwitchArchiveView records={records} />
</SiteLayout>
