---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BuildComponentCards from '../../components/BuildComponentCards.astro';
import DisplayFields from '../../components/DisplayFields.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import Lightbox from '../../components/Lightbox.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadBuildComponentCoverResolver, type BuildComponentPresentation } from '../../lib/build-component-covers';
import { buildKeyboardDetailFields } from '../../lib/keyboard-display';

export async function getStaticPaths() {
  const [keyboards, withCover] = await Promise.all([
    getCollection('keyboards'),
    loadBuildComponentCoverResolver(),
  ]);
  return keyboards.map((entry) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      keycaps: entry.data.build.keycaps.map(withCover),
      switches: entry.data.build.switches.map(withCover),
    },
  }));
}

type Keyboard = CollectionEntry<'keyboards'>['data'];

interface Props {
  entry: CollectionEntry<'keyboards'>;
  keycaps: Array<Keyboard['build']['keycaps'][number] & BuildComponentPresentation>;
  switches: Array<Keyboard['build']['switches'][number] & BuildComponentPresentation>;
}

const { entry, keycaps, switches } = Astro.props;
const keyboard = entry.data;
const fields = buildKeyboardDetailFields(keyboard);
const components = [...keycaps, ...switches];
const hasBuildSpec = fields.length > 0 || components.length > 0;
---

<SiteLayout title={keyboard.title}>
  <article class:list={['detail shell keyboard-build-detail', {
    'has-spec-column': keyboard.images.length > 0 && hasBuildSpec,
  }]}>
    <div class="keyboard-build-gallery">
      <ImageGallery images={keyboard.images} label={keyboard.title} />
      <header class="keyboard-build-caption">
        <h1>{keyboard.title}</h1>
      </header>
    </div>

    {hasBuildSpec && (
      <section class="keyboard-build-spec" aria-labelledby="keyboard-build-spec-heading">
        <h2 id="keyboard-build-spec-heading" lang="en">Build Spec</h2>
        {components.length > 0 && <BuildComponentCards items={components} layout="rows" />}
        <DisplayFields fields={fields} variant="detail" />
      </section>
    )}
  </article>
  <Lightbox />
</SiteLayout>

<style>
  .keyboard-build-detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: clamp(24px, 4vw, 52px);
    padding-top: clamp(24px, 5vw, 64px);
  }

  .keyboard-build-gallery,
  .keyboard-build-spec {
    min-width: 0;
  }

  .keyboard-build-gallery :global(.image-gallery figure.is-featured img) {
    aspect-ratio: auto;
    max-height: none;
  }

  .keyboard-build-caption {
    padding-block: clamp(14px, 2vw, 24px);
    border-bottom: 1px solid var(--color-rule);
  }

  .keyboard-build-caption h1 {
    margin: 0;
    font-size: clamp(1.75rem, 4.2vw, 3.5rem);
    font-weight: 660;
    letter-spacing: -.045em;
    line-height: 1.08;
    overflow-wrap: anywhere;
  }

  .keyboard-build-spec h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 640;
  }

  .keyboard-build-spec :global(.display-fields.is-detail) {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 112px), 1fr));
    column-gap: 14px;
    margin-top: 16px;
  }

  @media (min-width: 760px) {
    .keyboard-build-detail.has-spec-column {
      grid-template-columns: minmax(0, 2.25fr) minmax(0, 1fr);
    }
  }
</style>
