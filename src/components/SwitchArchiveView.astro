---
import type { CollectionEntry } from 'astro:content';
import collectionData from '../data/collections.json';
import {
  archiveDisplayGroups,
  groupIdsForRecord,
  groupsWithCounts,
  recordsForCollectionView,
  type CollectionManifest,
} from '../lib/collection-views';
import ArchiveSearch from './ArchiveSearch.astro';
import ArchiveViewTabs from './ArchiveViewTabs.astro';
import DomainRecordCard from './DomainRecordCard.astro';

interface Props {
  records: CollectionEntry<'records'>[];
}

const { records } = Astro.props;
const manifest = collectionData as CollectionManifest;
const pageCopy = manifest.copy;
const products = records.map((entry) => entry.data);
const switches = recordsForCollectionView(products, manifest, 'switch-manufacturers');
const franken = recordsForCollectionView(products, manifest, 'switch-franken');
const switchGroups = archiveDisplayGroups(switches, manifest, 'switch-manufacturers');
const frankenGroups = archiveDisplayGroups(franken, manifest, 'switch-franken');
const makerGroups = groupsWithCounts(switches, manifest, ['switch-manufacturers']);
---

<section class="archive-intro shell" aria-labelledby="switch-title">
  <h1 id="switch-title">{pageCopy?.['switch.title'] ?? '스위치'}</h1>
</section>

<div class="archive-tools shell">
  <ArchiveViewTabs
    id="switch"
    label="스위치 보기"
    parameter="view"
    views={[{ id: 'switches', label: '스위치' }, { id: 'franken', label: '프랑켄' }]}
  />
  <ArchiveSearch />
</div>

<div class="archive-sections">
  <section id="switch-panel-switches" class="archive-section shell" role="tabpanel" aria-labelledby="switch-tab-switches">
    <div class="switch-filters" data-switch-filters>
      <fieldset>
        <legend>제조사</legend>
        <div class="switch-filter-options">
          {[{ id: '', label: '전체' }, ...makerGroups].map((group) => (
            <label>
              <input
                class="visually-hidden"
                type="radio"
                name="maker"
                value={group.id}
                checked={group.id === ''}
              />
              <span>{group.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
    </div>
    <p class="visually-hidden" role="status" data-switch-result-count></p>
    <p data-switch-empty hidden>조건에 맞는 스위치가 없습니다.</p>
    {switchGroups.map(({ label, records }) => (
      <section class="archive-section" aria-label={label ?? '스위치 목록'} data-archive-group>
        {label && <div class="section-heading"><h2>{label}</h2></div>}
        <div class="gallery-grid archive-section-grid">
          {records.map((record) => (
            <DomainRecordCard
              record={record}
              headingLevel={label ? 3 : 2}
              groups={groupIdsForRecord(record, manifest, ['switch-manufacturers'])}
            />
          ))}
        </div>
      </section>
    ))}
  </section>

  <section id="switch-panel-franken" class="archive-section shell" role="tabpanel" aria-labelledby="switch-tab-franken" hidden>
    {frankenGroups.map(({ label, records }) => (
      <section class="archive-section" aria-label={label ?? '프랑켄 스위치 목록'} data-archive-group>
        {label && <div class="section-heading"><h2>{label}</h2></div>}
        <div class="gallery-grid archive-section-grid">
          {records.map((record) => <DomainRecordCard record={record} headingLevel={label ? 3 : 2} />)}
        </div>
      </section>
    ))}
    {franken.length === 0 && <p>조건에 맞는 프랑켄 스위치가 없습니다.</p>}
  </section>
</div>

<script>
  const filters = document.querySelector<HTMLElement>('[data-switch-filters]');
  const panel = document.getElementById('switch-panel-switches');
  if (filters && panel) {
    const makers = [...filters.querySelectorAll<HTMLInputElement>('input[name="maker"]')];
    const cards = [...panel.querySelectorAll<HTMLElement>('[data-archive-card]')].map((card) => ({
      card,
      href: card.querySelector('a')!.href,
      groups: new Set<string>(JSON.parse(card.dataset.groups ?? '[]')),
    }));
    const count = panel.querySelector('[data-switch-result-count]');
    const empty = panel.querySelector<HTMLElement>('[data-switch-empty]');
    const showResultCount = () => {
      const visible = new Set(cards.filter(({ card }) => !card.hidden).map(({ href }) => href)).size;
      if (count) count.textContent = `${visible}개 스위치`;
      if (empty) empty.hidden = visible !== 0;
    };
    const apply = (updateUrl = false) => {
      const maker = makers.find((input) => input.checked)?.value ?? '';
      for (const { card, groups: membership } of cards) {
        card.dataset.groupMatch = String(!maker || membership.has(maker));
      }
      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.delete('collection');
        url.searchParams.delete('rating');
        if (maker) url.searchParams.set('maker', maker);
        else url.searchParams.delete('maker');
        window.history.replaceState(null, '', url);
      }
      window.dispatchEvent(new CustomEvent('keylog:group-filter'));
      requestAnimationFrame(showResultCount);
    };
    const fromLocation = () => {
      const params = new URLSearchParams(window.location.search);
      const requested = params.get('maker') ?? params.get('collection');
      const input = makers.find((candidate) => candidate.value === requested) ?? makers[0];
      if (input) input.checked = true;
      apply();
    };
    filters.addEventListener('change', () => apply(true));
    document.querySelector('[data-archive-search]')?.addEventListener('input', () => {
      requestAnimationFrame(showResultCount);
    });
    window.addEventListener('popstate', fromLocation);
    fromLocation();
  }
</script>

<style>
  .archive-tools {
    column-gap: 24px;
  }

  .switch-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    padding-block: 16px 4px;
  }

  fieldset {
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    margin-block-end: 4px;
    color: var(--color-muted);
    font-size: 13px;
  }

  .switch-filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  label {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 8px;
    border: 1px solid transparent;
    border-radius: var(--radius-card);
    color: var(--color-text);
    font-size: 14px;
    cursor: pointer;
  }

  label:hover {
    border-color: var(--color-rule);
  }

  label:has(input:checked) {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-panel);
  }

  label:has(input:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>
