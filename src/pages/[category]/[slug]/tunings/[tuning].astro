---
import { getCollection } from 'astro:content';
import DisplayFields from '../../../../components/DisplayFields.astro';
import ImageGallery from '../../../../components/ImageGallery.astro';
import Lightbox from '../../../../components/Lightbox.astro';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { renderTuningComponent, tuningComponentRoleLabels } from '../../../../../public/ui/tuning-components.mjs';
import {
  buildSwitchTuningFields,
  publicSwitchTunings,
  type SwitchTuning,
} from '../../../../lib/switch-tuning-display';

export async function getStaticPaths() {
  const entries = await getCollection('records');
  return entries.flatMap(({ data: record }) => publicSwitchTunings(record).map(({ key, label, tuning }) => ({
    params: { category: 'switches', slug: record.slug, tuning: key },
    props: { productTitle: record.modelFamily?.title ?? record.title, productSlug: record.modelFamily?.slug ?? record.slug, label, tuning },
  })));
}

interface Props {
  productTitle: string;
  productSlug: string;
  label: string;
  tuning: SwitchTuning;
}

const { productTitle, productSlug, label, tuning } = Astro.props;
const title = productTitle === label ? label : `${productTitle} · ${label}`;
const components = tuning.components ?? [];
const fields = buildSwitchTuningFields(tuning).filter(field => {
  if (components.some(c=>c.role==='spring') && ['spring','initial_force','actuation_force','tactile_force','bottom_out_force','final_force','length','spring_stage'].includes(field.key)) return false;
  if (components.some(c=>c.role==='stem_lubricant') && field.key==='stemLubrication') return false;
  if (components.some(c=>c.role==='spring_lubricant') && field.key==='springLubrication') return false;
  if (components.some(c=>c.role==='stem_lubricant') && components.some(c=>c.role==='spring_lubricant') && field.key==='lubrication') return false;
  return true;
});
const detailImages = tuning.detailImageIndexes
  ? tuning.detailImageIndexes.map((index) => tuning.images[index]).filter(Boolean)
  : tuning.images;
const specificationImages = tuning.isStock || tuning.isFactoryConfiguration
  ? tuning.specificationImages ?? [] : [];
---

<SiteLayout title={title}>
  <article class="detail shell">
    <header class="detail-header">
      <a class="switch-product-link" href={`/switches/${productSlug}/`}>
        <span aria-hidden="true">←</span> {productTitle}
      </a>
      <h1>{label}</h1>
    </header>

    <ImageGallery images={detailImages} label={title} />
    {components.length > 0 && <section class="record-section kl-gallery-scope" aria-label="구성 부품">
      <div class="kl-gallery" data-gallery-role="relation">
        {components.map(component => <section class="k-tuning-component"><h2>{tuningComponentRoleLabels[component.role]}</h2><Fragment set:html={renderTuningComponent(component)} /></section>)}
      </div>
    </section>}

    {fields.length > 0 && (
      <section class="series-properties" aria-label="세팅 사양">
        <DisplayFields fields={fields} variant="detail" />
      </section>
    )}
    {specificationImages.length > 0 && <section class="record-section" aria-label="Stock specifications">
      <ImageGallery images={specificationImages} label={`${productTitle} Stock specifications`} />
    </section>}
  </article>
  <Lightbox />
</SiteLayout>

<style>
  .switch-product-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--k-muted);
    font-size: 14px;
  }

  .switch-product-link:hover {
    text-decoration: underline;
    text-underline-offset: .18em;
  }
</style>
