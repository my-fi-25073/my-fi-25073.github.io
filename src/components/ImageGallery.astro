---
interface ImageVariant {
  src: string;
  width: number;
  height: number;
}

interface GalleryImage {
  alt: string;
  caption?: string;
  variants: ImageVariant[];
}

interface Props {
  images: GalleryImage[];
  label: string;
  compact?: boolean;
}

const { images, label, compact = false } = Astro.props;
---

{images.length > 0 && (
  <div class:list={['image-gallery', { 'is-compact': compact }]} role="group" aria-label={label} data-image-gallery>
    {images.map((item, index) => {
      const variants = item.variants.toSorted((a, b) => a.width - b.width);
      const display = variants[0];
      const full = variants.at(-1) ?? display;
      const srcset = variants.map((variant) => `${variant.src} ${variant.width}w`).join(', ');
      return (
        <figure class:list={{ 'is-featured': index === 0 }}>
          <button
            class="image-gallery-button"
            type="button"
            data-lightbox-open
            data-full={full.src}
            data-alt={item.alt}
            data-caption={item.caption ?? ''}
            aria-label={`${label} 사진 ${index + 1} 크게 보기`}
          >
            <img
              src={display.src}
              srcset={srcset}
              sizes={compact
                ? '(min-width: 960px) 28vw, (min-width: 560px) 50vw, 100vw'
                : '(min-width: 1200px) 54vw, (min-width: 760px) 72vw, 100vw'}
              width={display.width}
              height={display.height}
              alt={item.alt}
              loading={!compact && index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </button>
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      );
    })}
  </div>
)}
