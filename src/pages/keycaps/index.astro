---
import { getCollection } from 'astro:content';
import ArchiveSidebar from '../../components/ArchiveSidebar.astro';
import ArchiveViewTabs from '../../components/ArchiveViewTabs.astro';
import GalleryCard from '../../components/GalleryCard.astro';
import collectionData from '../../data/collections.json';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  keycapArchiveViews,
  navigationLabel,
  recordsForCollectionView,
  recordsGroupedByField,
  requiredCollectionView,
  type CollectionManifest,
} from '../../lib/collection-views';

const manifest = collectionData as CollectionManifest;
const pageCopy = manifest.copy;
const title = navigationLabel(manifest, '/keycaps/');
const entries = (await getCollection('gallery', ({ data }) => !data.hideFromArchive)).map((entry) => entry.data);
const titleCounts = new Map<string, number>();
for (const entry of entries) {
  titleCounts.set(entry.title, (titleCounts.get(entry.title) ?? 0) + 1);
}
const allRecords = recordsForCollectionView(entries, manifest, 'keycap-collections');
const profileGroup = requiredCollectionView(manifest, 'keycap-collections').query.group;
if (profileGroup?.field !== 'profile' || !profileGroup.order?.length) {
  throw new Error('Missing Keycap profile grouping.');
}
const allGroups = recordsGroupedByField(allRecords, 'profile', profileGroup.order).map((group) => {
  if (group.label && !profileGroup.order!.includes(group.label)) {
    throw new Error(`Unknown Keycap profile: ${group.label}`);
  }
  return { ...group, label: group.label ?? 'Unspecified' };
});
const keycapViews = [
  ...keycapArchiveViews(manifest).map(({ view, query, id, label }) => {
    const groupRule = query.group;
    if (query.entityKind !== 'keycap_series' || (groupRule && (
      groupRule.unit !== 'value' || !groupRule.field || !Array.isArray(groupRule.order)
    ))) {
      throw new Error(`Invalid Keycap view grouping: ${view.id}`);
    }
    const records = recordsForCollectionView(entries, manifest, view.id);
    const groupField = groupRule?.field;
    const groups = groupField
      ? recordsGroupedByField(records, groupField, groupRule?.order ?? [], groupRule?.direction)
      : [{ label: null, records }];
    return {
      id,
      label,
      aliases: id === 'keyreative' ? ['fkcaps'] : undefined,
      count: records.length,
      groups,
    };
  }),
  {
    id: 'all',
    label: 'All',
    count: allRecords.length,
    groups: allGroups,
  },
];
---

<SiteLayout title={title} description={pageCopy?.['keycap.description'] ?? undefined}>
  <div class="shell archive-catalog-shell" data-archive-filter>
    <section class="archive-catalog-heading" aria-labelledby="keycap-title">
      <h1 id="keycap-title" lang="en">{title}</h1>
    </section>
    <div class="archive-catalog-layout">
      <ArchiveSidebar label="Keycap navigation" searchLabel="Search keycaps">
        <details class="keycap-collections" data-archive-disclosure open>
          <summary>Collection</summary>
          <div class="keycap-filter-bar">
            <p aria-hidden="true">Collection</p>
            <ArchiveViewTabs id="keycap" label="Keycap collections" parameter="collection" views={keycapViews} orientation="vertical" />
          </div>
        </details>
      </ArchiveSidebar>

      <div class="keycap-panels archive-catalog-main archive-catalog-gallery">
        {keycapViews.map((view, index) => {
          const deferred = index !== 0;
          const Content = deferred ? 'template' : 'div';
          return (
            <section
              class="keycap-view"
              id={`keycap-panel-${view.id}`}
              role="tabpanel"
              aria-labelledby={`keycap-tab-${view.id}`}
              hidden={deferred}
              data-archive-search-panel
            >
              <Content data-archive-panel-content={deferred ? '' : undefined}>
                <p class="visually-hidden" aria-live="polite" aria-atomic="true">Results: <span data-archive-search-count>{view.count}</span></p>
                <p class="keycap-empty" data-archive-search-empty hidden={view.count > 0}>No matching keycaps.</p>
                {view.groups.map((group) => {
                  const Group = group.label ? 'details' : 'div';
                  return (
                    <Group class="keycap-view-group kl-gallery-scope" data-archive-group open={group.label ? true : undefined}>
                      {group.label && <summary><h2>{group.label}</h2><span class="keycap-group-count">{group.records.length}</span></summary>}
                      <div class="gallery-grid kl-gallery" data-gallery-role="archive">
                        {group.records.map((gallery) => (
                          <GalleryCard
                            gallery={gallery}
                            headingLevel={group.label ? 3 : 2}
                            showProfile={(titleCounts.get(gallery.title) ?? 0) > 1}
                          />
                        ))}
                      </div>
                    </Group>
                  );
                })}
              </Content>
            </section>
          );
        })}
      </div>
    </div>
  </div>
</SiteLayout>

<style>
  .keycap-collections { min-width: 0; }
  .keycap-collections > summary { display: none; }
  .keycap-filter-bar > p { margin: 0 0 4px; font-size: 13px; font-weight: 680; }

  @media (max-width: 660px) {
    .keycap-collections > summary { display: flex; }
    .keycap-filter-bar { padding-block: 8px; }
    .keycap-filter-bar > p { display: none; }
  }

  .keycap-empty { margin: 24px 0 0; color: var(--k-muted); }

  .keycap-view-group + .keycap-view-group {
    margin-block-start: var(--k-section-space);
  }

  h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 650;
  }

  .keycap-group-count { color: var(--k-muted); font-size: 12px; font-variant-numeric: tabular-nums; }
</style>
