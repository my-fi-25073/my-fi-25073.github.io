<div class="archive-search" role="search">
  <label class="visually-hidden" for="archive-search-input">이름 검색</label>
  <input
    id="archive-search-input"
    type="search"
    placeholder="이름 검색"
    autocomplete="off"
    data-archive-search
  />
</div>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-archive-search]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-archive-card]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-archive-group]')];
  if (input) {
    const update = () => {
      const query = input.value.trim().toLocaleLowerCase('ko');
      for (const card of cards) {
        const matchesSearch = !query || (card.dataset.search ?? '').includes(query);
        const matchesGroup = card.dataset.groupMatch !== 'false';
        const matches = matchesSearch && matchesGroup;
        card.hidden = !matches;
      }
      for (const group of groups) {
        const groupCards = [...group.querySelectorAll<HTMLElement>('[data-archive-card]')];
        group.hidden = groupCards.every((card) => card.hidden);
      }
    };
    input.addEventListener('input', update);
    window.addEventListener('keylog:group-filter', update);
    update();
  }
</script>
